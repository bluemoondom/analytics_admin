# Analytics admin configuration

# MSSQL source database
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# Dashboard metadata storage: sqlite or mssql
DASHBOARD_STORAGE_BACKEND=sqlite
DASHBOARD_DB_PATH=dashboards.sqlite3

# Encryption key for secrets stored in the dashboard database (db_password, api_key).
# If left empty the app generates a new key and writes it to this file on first start.
# Keep this value secret and back it up – losing it makes stored secrets unreadable.
STORAGE_ENCRYPTION_KEY=

# View discovery mode: tabobecny_prehled or sys_views
VIEW_DISCOVERY_MODE=tabobecny_prehled

# Public API for exported views
API_KEY=change-me-to-a-long-random-string
API_KEY_HEADER=X-API-Key
API_ALLOWED_IPS=127.0.0.1,172.18.0.60
API_TENANT=domi
API_BASE_URL=http://127.0.0.1:8000/domi
APP_BASE_URL=http://127.0.0.1:8000
API_MAX_REQUESTS_PER_MINUTE=0
API_LOG_PATH=logs/api_access.log

# HTTP security hardening
# Comma-separated list of hosts allowed to reach the app (Host header).
# Defaults to localhost, 127.0.0.1, [::1], testserver and the API_BASE_URL host.
TRUSTED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated list of cross-origin sites allowed to call the API.
# Empty = cross-origin access fully disabled (recommended for same-origin app).
CORS_ALLOWED_ORIGINS=
# Custom Content-Security-Policy. Empty disables the header.
CSP_POLICY=
# Send Strict-Transport-Security header. Defaults to true unless LOCALHOST_MODE.
HSTS_ENABLED=true

# HTTP listener for the admin web application
HTTP_HOST=127.0.0.1
HTTP_PORT=8000

# Optional separate listener for the public API. When both API_HOST and API_PORT
# are set, the public API (paths under API_TENANT) is served on its own port.
# Leave empty to keep the API on the same listener as the admin app.
API_HOST=127.0.0.1
API_PORT=8000

# SSL / HTTPS. Either point uvicorn at PEM files directly...
SSL_CERTFILE=
SSL_KEYFILE=
# ...or extract a Windows PFX bundle (.pfx/.p12) on startup.
#   The cert chain and private key are written into temporary PEM files that
#   are removed when the process exits.
SSL_PFX_PATH=
SSL_PFX_PASSWORD=

# Magic-link / JWT authentication
# REQUIRED: generate a long random string, e.g. with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Localhost mode: disables Secure cookie flag for local development
LOCALHOST_MODE=false

# SMTP configuration for magic-link emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@example.com
SMTP_STARTTLS=true
